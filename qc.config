params {

    // == TOOLS ===
    short_assembler = 'unicycler'
    long_assembler = 'autocycler'

    // === DATABASES ===
    sylph_db = "/pub63/tom22/databases/PseudoNovo/gtdb-r232-c200-dbv2.syl2db"
    poppunk_db = "/pub63/tom22/databases/PseudoNovo/pa_v1_refs"
    checkm2_db = "/pub63/tom22/databases/PseudoNovo/uniref100.KO.1.dmnd"
    bakta_db = "/pub63/tom22/databases/PseudoNovo/db"
    card_db = "/pub63/tom22/databases/PseudoNovo/card"
    gtdb = "/pub63/tom22/databases/PseudoNovo/release232"
    genomad_db = "/pub63/tom22/databases/PseudoNovo/genomad_db"
    checkv_db = "/pub63/tom22/databases/PseudoNovo/checkv-db-v1.5"
    defensefinder_models = "/pub63/tom22/databases/PseudoNovo/defense-finder-models"
    gapseq_db = "/pub63/tom22/databases/PseudoNovo/gapseq_seqDB"
    
    // === MAIN ===
    mode = 'short'
    skip_preprocessing = false

    // === QC OPTIONS ===
    min_depth = 30
    target_genome_size = 6250000
    target_gc_content = 0.66
    completeness = 99
    contamination = 2
    gtdb_classification = "d__Bacteria;p__Pseudomonadota;c__Gammaproteobacteria;o__Pseudomonadales;f__Pseudomonadaceae;g__Pseudomonas;s__Pseudomonas aeruginosa"

    // === SHORT READ OPTIONS ===
    fastqc_pass_criteria = "${projectDir}/assets/fastqc_pass_criteria.json"
    lower_assembly_length = 5500000
    min_contig_length = 500
    unicycler_mode = "normal"

    // === LONG READ OPTIONS ===
    long_read_platform = "ont"
    trim_adaptors = false
    minimum_phred_score = 15
    min_read_length = 1000
    downsample_reads = false
    target_coverage = 30
    autocycler_subsets = 4

}
