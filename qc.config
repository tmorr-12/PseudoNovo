params {

    // === DATABASES ===
    sylph_db = "/pub63/tom22/databases/gtdb-r232-c200-dbv2.syl2db"
    checkm2_db = "/pub63/tom22/databases/CheckM2_database/uniref100.KO.1.dmnd"
    bakta_db = "/pub63/tom22/databases/db"
    card_db = "/pub63/tom22/databases/card"
    gtdb = "/pub63/tom22/databases/release232"
    genomad_db = "/pub63/tom22/databases/genomad_db"
    checkv_db = "/pub63/tom22/databases/checkv-db-v1.5"
    defensefinder_models = "/pub63/tom22/.macsyfinder/models"

    human_ref = "/pub63/tom22/databases/GCF_009914755.1_T2T-CHM13v2.0_genomic.fna"
    IPD-IMGT_HLA = "/pub63/tom22/databases/hla_gen.fasta" 
    
    // === MAIN ===
    mode = 'short'
    skip_preprocessing = false

    // === QC OPTIONS ===
    min_depth = 30
    target_genome_size = 6250000
    target_gc_content = 0.66
    completeness = 99
    contamination = 2
    gtdb_classification = "d__Bacteria;p__Pseudomonadota;c__Gammaproteobacteria;o__Pseudomonadales;f__Pseudomonadaceae;g__Pseudomonas;s__Pseudomonas aeruginosa"

    // === SHORT READ OPTIONS ===
    fastqc_pass_criteria = "${projectDir}/assets/fastqc_pass_criteria.json"
    lower_assembly_length = 5500000
    min_contig_length = 500
    unicycler_mode = "conservative"
    reference = null
    min_mapping_rate = 0.8
    max_error_rate = 0.02

    // === LONG READ OPTIONS ===
    long_read_platform = "ont"
    trim_adaptors = false
    minimum_phred_score = 15
    min_read_length = 1000
    downsample_reads = false
    target_coverage = 30
    autocycler_subsets = 4

}

env {
    GTDBTK_DATA_PATH = params.gtdb
    CHECKVDB = params.checkv_db
}

process {
    withName: 'GTDBTK' {
        containerOptions = "-B ${params.gtdb}"
    }
    withName: 'CHECKV' {
        containerOptions = "-B ${params.checkv_db}"
    }
    withName: 'DEFENSE_FINDER' {
        containerOptions = "-B ${params.defensefinder_models}"
    }
}