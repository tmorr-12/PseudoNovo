%%metro title: PseudoNovo
%%metro stroke_scale: 1.4
%%metro compact_offsets: true
%%metro font_scale: 1.5
%%metro track_gap: 2.5
%%metro mode: dark
%%metro style: nfcore
%%metro file: short_reads_in | FASTQ
%%metro file: long_reads_in | FASTQ
%%metro line: short | Short Reads | #0098D4
%%metro line: long | Long Reads | #FFD300
%%metro line: hybrid | Hybrid Reads | #F0443A
%%metro line: help1 | * Entry point if --skip_preprocessing flag is supplied | #ffffff

graph LR
    subgraph short_pre [FASTQ Preprocessing]
        fastqc([FastQC])
        fastp([Fastp])
        sylph_sh([Sylph])

        short_reads_in -->|short| fastp
        fastp -->|short| fastqc
        fastqc -->|short| sylph_sh

        porechop_abi([Porechop_ABI / Chopper])
        sylph_lg([Sylph])
        nanoplot([Nanoplot / Rasusa])

        long_reads_in -->|long| porechop_abi
        porechop_abi -->|long| sylph_lg
        sylph_lg -->|long| nanoplot
    end
    subgraph assembly [Assembly*]
        %% Short read assembly
        unicycler([Unicycler / Shovill])
        _test([test])
        
        unicycler -->|short| _test
        
        %% Long read assembly
        autocycler([Autocycler / Flye])
        medaka([Medaka])

        autocycler -->|long| medaka
        
        %% Hybrid read assembly
        polypolish([Polypolish])
        pypolca([Pypolca])

        autocycler -->|hybrid| polypolish
        polypolish -->|hybrid| pypolca
    end
    subgraph assembly_qc[Assembly QC]
    	quast([Quast])
        checkm2([CheckM2])
        mlst([mlst])
        poppunk([PopPUNK])
        gtdbtk([GTDB-Tk])
	end
    subgraph annotation[Annotation]
    	bakta([Bakta])
        abricate([Abricate])
        rgi([RGI])
        genomad([geNomad])
        defensefinder([DefenseFinder])
    end

	sylph_sh -->|short| unicycler
	nanoplot -->|long| autocycler
    sylph_sh -->|hybrid| polypolish
    
    _test -->|short| quast
    _test -->|short| checkm2
    _test -->|short| mlst
    _test -->|short| poppunk
    _test -->|short| gtdbtk
    
    pypolca -->|hybrid| quast
    pypolca -->|hybrid| checkm2
    pypolca -->|hybrid| mlst
    pypolca -->|hybrid| poppunk
    pypolca -->|hybrid| gtdbtk
    
    medaka -->|long| quast
    medaka -->|long| checkm2
    medaka -->|long| mlst
    medaka -->|long| poppunk
    medaka -->|long| gtdbtk
    
    quast -->|short,hybrid,long| bakta
    checkm2 -->|short,hybrid,long| bakta
    mlst -->|short,hybrid,long| bakta
    poppunk -->|short,hybrid,long| bakta
    gtdbtk -->|short,hybrid,long| bakta
    
    quast -->|short,hybrid,long| abricate
    checkm2 -->|short,hybrid,long| abricate
    mlst -->|short,hybrid,long| abricate
    poppunk -->|short,hybrid,long| abricate
    gtdbtk -->|short,hybrid,long| abricate
    
    quast -->|short,hybrid,long| rgi
    checkm2 -->|short,hybrid,long| rgi
    mlst -->|short,hybrid,long| rgi
	poppunk -->|short,hybrid,long| rgi
    gtdbtk -->|short,hybrid,long| rgi

	quast -->|short,hybrid,long| genomad
    checkm2 -->|short,hybrid,long| genomad
    mlst -->|short,hybrid,long| genomad
    poppunk -->|short,hybrid,long| genomad
    gtdbtk -->|short,hybrid,long| genomad
    
    quast -->|short,hybrid,long| defensefinder
    checkm2 -->|short,hybrid,long| defensefinder
    mlst -->|short,hybrid,long| defensefinder
    poppunk -->|short,hybrid,long| defensefinder
    gtdbtk -->|short,hybrid,long| defensefinder
