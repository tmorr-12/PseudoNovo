manifest {
    name = 'PseudoNovo'
    author = 'Tom Morrison'
    description = 'Hybrid Pseudomonas De Novo Assembly Pipeline'
    version = '0.0.1'
    nextflowVersion = '>=26.04.6'
}

includeConfig "${projectDir}/qc.config"

params {
    input = null
    outdir = "./results"

    help = false
    publish_dir_mode = 'copy'
}

/*
=== Pipeline setup options ===
*/

process.shell = ['/bin/bash', '-euo', 'pipefail']

dag {
    enabled = true
    file = "${params.outdir}/pipeline-info/pipeline_dag.mmd"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline-info/execution_trace_${new Date().format('yyyyMMdd_HHmmss')}.txt"
}

/*
=== Profiles  ===
*/

profiles {
    standard {
        process {
            maxRetries = 2
            errorStrategy = 'finish'

            withLabel: minimal {
                cpus = 1
                memory = 512.MB
                time = 1.h
            }
            withLabel: tiny {
                cpus = 1
                memory = 1.GB
                time = 1.h
            }
            withLabel: small {
                cpus = 2
                memory = 2.GB
                time = 1.h
            }
            withLabel: medium {
                cpus = 4
                memory = 7.GB
                time = 12.h
            }
            withLabel: large {
                cpus = 8
                memory = 12.GB
                time = 12.h
            }
            withLabel: huge {
                cpus = 16
                memory = 48.GB
                time = 24.h
            }
            withLabel: mega {
                cpus = 64
                memory = 96.GB
                time = 48.h
            }
            withLabel: gtdb {
                cpus = 80
                memory = 160.GB
            }
        }
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "/pub63/tom22/singularity_cache"
        }
    }
}
